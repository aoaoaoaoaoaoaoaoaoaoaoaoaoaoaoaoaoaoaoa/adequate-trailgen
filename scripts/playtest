#!/bin/sh
set -eu

out=${1:?usage: scripts/playtest OUTPUT_DIR [PROJECT]}
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
project=${2:-$root/demo/mini-loop}
mkdir -p "$out"
target=$(cargo metadata --format-version 1 --no-deps --manifest-path "$root/Cargo.toml" \
    | jq -r .target_directory)
app=${TRAILGEN_GUI_BIN:-$target/debug/trailgen}

if [ "${TRAILGEN_GUI_RESUME:-0}" = 1 ]; then
    if [ "${TRAILGEN_GUI_ONLINE:-0}" = 1 ]; then
        setsid "$app" gui >"$out/app.log" 2>&1 &
    else
        setsid "$app" gui --offline >"$out/app.log" 2>&1 &
    fi
elif [ "${TRAILGEN_GUI_ONLINE:-0}" = 1 ]; then
    setsid "$app" gui "$project" >"$out/app.log" 2>&1 &
else
    setsid "$app" gui "$project" --offline >"$out/app.log" 2>&1 &
fi
leader=$!
cleanup() {
    kill -- "-$leader" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

window=$(timeout 20 xdotool search --sync --class '^trailgen$')
xdotool windowmap --sync "$window"
xdotool windowfocus --sync "$window"
xwininfo -id "$window" >"$out/window.txt"

if [ "${TRAILGEN_GUI_ONLINE:-0}" = 1 ] && [ "${TRAILGEN_GUI_RESUME:-0}" != 1 ]; then
    attempts=0
    while ! test -s "$project/cache/basemap.pmtiles"; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 240 ]; then
            import -window "$window" "$out/basemap-timeout.png"
            printf 'timed out forging %s\n' "$project/cache/basemap.pmtiles" >&2
            exit 1
        fi
        sleep 0.25
    done
fi

sleep 1
import -window "$window" "$out/atlas.png"

if [ -n "${TRAILGEN_GUI_GENESIS_ROOT:-}" ]; then
    xdotool mousemove --window "$window" 700 408 click 1
    xdotool key --window "$window" ctrl+a
    xdotool type --window "$window" --delay 1 "$TRAILGEN_GUI_GENESIS_ROOT"
    xdotool mousemove --window "$window" 515 478 click 1
    sleep 1
    import -window "$window" "$out/genesis-forged.png"
fi

# The terrain-law recess carries the per-surface admissibility and mix envelope.
xdotool mousemove --window "$window" 130 849 click 1
sleep 0.4
import -window "$window" "$out/terrain-law.png"
xdotool mousemove --window "$window" 130 849 click 1

# Exercise the real exact-enumerator path on the fixture graph.
xdotool mousemove --window "$window" 130 118 click 1
sleep 1
import -window "$window" "$out/forged.png"

# The first gallery plate opens the vector focus surface and elevation profile.
xdotool mousemove --window "$window" 410 790 click 1
xdotool windowfocus --sync "$window"
sleep 1
import -window "$window" "$out/focus.png"

# Cross the old z12 source ceiling and exercise fractional GPU overzoom.
xdotool mousemove --window "$window" 900 350
xdotool click --repeat 8 --delay 70 4
sleep 1
import -window "$window" "$out/deep-zoom.png"

# Candidate navigation and dismissal are keyboard contracts.
xdotool key --window "$window" Right
sleep 0.4
import -window "$window" "$out/next.png"
xdotool key --window "$window" Escape
sleep 0.4
import -window "$window" "$out/returned.png"
