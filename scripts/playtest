#!/bin/sh
set -eu

out=${1:?usage: scripts/playtest OUTPUT_DIR PROJECT}
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
project=${2:-}
if [ "${TRAILGEN_GUI_RESUME:-0}" != 1 ] && [ -z "$project" ]; then
    printf 'usage: scripts/playtest OUTPUT_DIR PROJECT\n' >&2
    exit 2
fi
mkdir -p "$out"
target=$(cargo metadata --format-version 1 --no-deps --manifest-path "$root/Cargo.toml" \
    | jq -r .target_directory)
app=${TRAILGEN_GUI_BIN:-$target/debug/trailgen}

if [ "${TRAILGEN_GUI_RESUME:-0}" = 1 ]; then
    if [ "${TRAILGEN_GUI_ONLINE:-0}" = 1 ]; then
        setsid "$app" gui >"$out/app.log" 2>&1 &
    else
        setsid "$app" gui --offline >"$out/app.log" 2>&1 &
    fi
elif [ "${TRAILGEN_GUI_ONLINE:-0}" = 1 ]; then
    setsid "$app" gui "$project" >"$out/app.log" 2>&1 &
else
    setsid "$app" gui "$project" --offline >"$out/app.log" 2>&1 &
fi
leader=$!
cleanup() {
    kill -- "-$leader" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

window=$(timeout 20 xdotool search --sync --class '^trailgen$')
xdotool windowmap --sync "$window"
xdotool windowfocus --sync "$window"
xwininfo -id "$window" >"$out/window.txt"

if [ "${TRAILGEN_GUI_ONLINE:-0}" = 1 ] && [ "${TRAILGEN_GUI_RESUME:-0}" != 1 ]; then
    attempts=0
    while :; do
        if { test -f "$project/cache/graph.json" \
                || test -f "$project/routes/generated.graph.json"; } \
            && find "$project/cache" -maxdepth 1 -type f -name 'basemap*.pmtiles' -size +0c \
                | grep -q .; then
            break
        fi
        if ! test -f "$project/cache/graph.json" \
            && ! test -f "$project/routes/generated.graph.json" \
            && test -s "$XDG_CACHE_HOME/trailgen/protomaps-v4/bootstrap-us.pmtiles"; then
            break
        fi
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 240 ]; then
            import -window "$window" "$out/basemap-timeout.png"
            printf 'timed out forging a vector basemap\n' >&2
            exit 1
        fi
        sleep 0.25
    done
    sleep "${TRAILGEN_GUI_BASEMAP_SETTLE_S:-1}"
fi

if [ -n "${TRAILGEN_GUI_WAIT_INDEX_SCHEMA:-}" ]; then
    attempts=0
    while ! jq -e --argjson schema "$TRAILGEN_GUI_WAIT_INDEX_SCHEMA" \
        '.schema == $schema' "$project/cache/trails.json" >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 600 ]; then
            import -window "$window" "$out/index-timeout.png"
            printf 'timed out waiting for trail index schema %s\n' \
                "$TRAILGEN_GUI_WAIT_INDEX_SCHEMA" >&2
            exit 1
        fi
        sleep 0.25
    done
    sleep 1
fi

sleep "${TRAILGEN_GUI_SETTLE_S:-0}"
attempts=0
while :; do
    import -window "$window" "$out/atlas.png"
    mean=$(identify -format '%[mean]' "$out/atlas.png")
    mean=${mean%%.*}
    if [ "$mean" -gt 10 ]; then
        break
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 200 ]; then
        printf 'timed out waiting for the first rendered frame\n' >&2
        exit 1
    fi
    sleep 0.1
done

if [ -n "${TRAILGEN_GUI_DECK_OPEN_ROOT:-}" ]; then
    xdotool mousemove --sync --window "$window" 600 425 click 1
    xdotool key --window "$window" ctrl+a
    xdotool type --window "$window" --delay 1 "$TRAILGEN_GUI_DECK_OPEN_ROOT"
    xdotool key --window "$window" Return
    sleep 1
    import -window "$window" "$out/project-opened.png"
    exit 0
fi

if [ -n "${TRAILGEN_GUI_CREATE_NAME:-}" ]; then
    parent=${TRAILGEN_GUI_CREATE_PARENT:?set TRAILGEN_GUI_CREATE_PARENT}
    created=${TRAILGEN_GUI_CREATE_ROOT:?set TRAILGEN_GUI_CREATE_ROOT}
    xdotool mousemove --sync --window "$window" 600 305
    xdotool click 1
    sleep 0.2
    xdotool type --delay 30 "$parent"
    sleep 1
    xdotool key shift+Tab
    sleep 0.5
    xdotool type --delay 30 "$TRAILGEN_GUI_CREATE_NAME"
    sleep 1
    xdotool mousemove --sync --window "$window" 480 349
    xdotool click 1
    attempts=0
    while ! test -f "$created/trailgen.toml"; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 100 ]; then
            import -window "$window" "$out/project-create-timeout.png"
            printf 'timed out creating %s\n' "$created" >&2
            exit 1
        fi
        sleep 0.1
    done
    sleep 0.5
    import -window "$window" "$out/project-created.png"
    exit 0
fi

if [ "${TRAILGEN_GUI_PROJECT_DECK:-0}" = 1 ]; then
    exit 0
fi

if [ "${TRAILGEN_GUI_REGION_PREVIEW:-0}" = 1 ]; then
    xdotool mousemove --sync --window "$window" 130 124 click 1
    xdotool mousemove --sync --window "$window" 1130 420
    xdotool click --repeat 11 --delay 70 4
    sleep 0.5
    xdotool mousemove --sync --window "$window" 980 340
    xdotool mousedown 1
    xdotool mousemove --sync --window "$window" 1120 475
    sleep 0.4
    import -window "$window" "$out/region-preview.png"
    xdotool mouseup 1
    sleep 1
    import -window "$window" "$out/region-fetch.png"
    exit 0
fi

if [ "${TRAILGEN_GUI_PROJECT_SWITCH:-0}" = 1 ]; then
    xdotool key --window "$window" ctrl+o
    sleep 0.5
    import -window "$window" "$out/project-deck.png"
    xdotool windowfocus --sync "$window"
    xdotool key --window "$window" Escape
    sleep 1
    import -window "$window" "$out/project-return.png"
    exit 0
fi

if [ "${TRAILGEN_GUI_ROAM:-0}" = 1 ]; then
    # The project opens fitted around Harriman. Keep an interior Harriman point
    # under the cursor while crossing the local archive ceiling and demanding
    # native z15 vectors from the roaming cache.
    import -window "$window" "$out/region.png"
    xdotool mousemove --window "$window" 756 423
    xdotool click --repeat 8 --delay 70 4
    cache=${TRAILGEN_GUI_ROAM_CACHE:?TRAILGEN_GUI_ROAM_CACHE must name the private cache}
    archive=$(find "$project/cache" -maxdepth 1 -type f -name 'basemap*.pmtiles' -print -quit)
    archive_zoom=0
    if [ -n "$archive" ]; then
        archive_zoom=$(od -An -t u1 -j101 -N1 "$archive" | tr -d ' ')
    fi
    attempts=0
    while [ "$archive_zoom" -lt 15 ] \
        && [ "$(find "$cache/15" -type f -name '*.mvt' 2>/dev/null | wc -l)" -lt 4 ]; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 240 ]; then
            import -window "$window" "$out/harriman-timeout.png"
            printf 'timed out filling Harriman vectors under %s\n' "$cache" >&2
            exit 1
        fi
        sleep 0.25
    done
    sleep 1
    import -window "$window" "$out/harriman.png"
    exit 0
fi

if [ "${TRAILGEN_GUI_ROAM_RESUME:-0}" = 1 ]; then
    sleep 1
    import -window "$window" "$out/harriman-resumed.png"
    exit 0
fi

if [ "${TRAILGEN_GUI_CARTOGRAPHY:-0}" = 1 ]; then
    # Cross from the project fit into street/topographic scale around Harriman.
    xdotool mousemove --window "$window" 756 423
    xdotool click --repeat 8 --delay 70 4
    attempts=0
    while ! test -s "$project/cache/isohypses-v3.bin"; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 240 ]; then
            import -window "$window" "$out/cartography-timeout.png"
            printf 'timed out forging topographic contours\n' >&2
            exit 1
        fi
        sleep 0.25
    done
    sleep 1
    import -window "$window" "$out/cartography.png"
    xdotool click 5
    sleep 0.4
    import -window "$window" "$out/cartography-zoom-out.png"
    xdotool click 4
    sleep 0.4
    import -window "$window" "$out/cartography-return.png"
    exit 0
fi

if [ "${TRAILGEN_GUI_EDITOR_FLOW:-0}" = 1 ]; then
    xdotool mousemove --sync --window "$window" 140 132 click 1
    sleep 0.5
    import -window "$window" "$out/editor-empty.png"
    xdotool mousemove --sync --window "$window" 781 396 click 1
    sleep 0.4
    xdotool mousemove --sync --window "$window" 850 400 click 1
    sleep 1
    import -window "$window" "$out/editor-route.png"
    xdotool key --window "$window" ctrl+z
    sleep 1
    import -window "$window" "$out/editor-undone.png"
    xdotool key --window "$window" ctrl+y
    sleep 1
    import -window "$window" "$out/editor-redone.png"
    # Seize the second pin's raised bulb and move it onto another spine.
    xdotool mousemove --sync --window "$window" 850 284
    xdotool mousedown 1
    sleep 0.2
    xdotool mousemove --sync --window "$window" 856 290
    sleep 0.2
    xdotool mousemove --sync --window "$window" 900 290
    sleep 0.2
    import -window "$window" "$out/editor-dragging.png"
    xdotool mouseup 1
    sleep 1
    import -window "$window" "$out/editor-moved.png"
    exit 0
fi

if [ "${TRAILGEN_GUI_SEARCH_FLOW:-0}" != 1 ]; then
    exit 0
fi

# Place a trailhead through the map contract, then exercise the common search
# engine through its keyboard accelerator.
xdotool mousemove --sync --window "$window" 108 194 click 1
sleep 0.4
xdotool mousemove --sync --window "$window" 756 423 click 1
sleep 1
import -window "$window" "$out/trailhead.png"
xdotool key --window "$window" ctrl+Return
sleep "${TRAILGEN_GUI_SEARCH_WAIT_S:-3}"
import -window "$window" "$out/results.png"

# Open the first transient result into the full-map/profile surface.
xdotool mousemove --sync --window "$window" 420 760 click 1
sleep 1
import -window "$window" "$out/focus.png"

# Promotion is explicit: transient search results enter the project library only
# through Save Trail, and survive after the focus view closes.
xdotool mousemove --sync --window "$window" 720 26 click 1
sleep 1
import -window "$window" "$out/saved-focus.png"
xdotool mousemove --sync --window "$window" 333 26 click 1
sleep 1
import -window "$window" "$out/library.png"
